#!/bin/sh
# A fake "claude" CLI, for the tests putting this directory in the PATH: it
# answers like fake-llm.sh, telling it was run through the "claude" definition,
# and in which mode.
case " $* " in
    *" --permission-mode acceptEdits "*) exec sh "$(dirname "$0")/../fake-llm.sh" 'claude, write' ;;
esac

exec sh "$(dirname "$0")/../fake-llm.sh" claude
